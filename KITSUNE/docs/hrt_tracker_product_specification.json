{
  "product": {
    "name": "HRT Tracker",
    "type": "offline_first_android_health_and_transition_tracking_application",
    "description": "A personal HRT, transition progress, health record, timeline, and analytics application.",
    "principles": [
      "offline_first",
      "local_data_ownership",
      "privacy",
      "accessibility",
      "long_term_tracking",
      "customizable_tracking"
    ],
    "profiles": [
      "trans_men",
      "trans_women"
    ],
    "dedicated_transition_inputs": 500
  },
  "main_navigation": [
    {
      "id": "home",
      "label": "Home",
      "description": "Dashboard and daily status."
    },
    {
      "id": "medications",
      "label": "Medications",
      "description": "HRT medications, schedules, doses, adherence, and refills."
    },
    {
      "id": "progress",
      "label": "Progress",
      "description": "Transition changes, measurements, photos, symptoms, labs, and charts."
    },
    {
      "id": "calendar",
      "label": "Calendar",
      "description": "Chronological view of doses, symptoms, appointments, and milestones."
    },
    {
      "id": "settings",
      "label": "Settings",
      "description": "Appearance, privacy, reminders, backup, export, custom fields, and application settings."
    }
  ],
